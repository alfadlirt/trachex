# Trachex environment configuration
# Copy to .env and fill in values. Never commit real secrets.

# ---- Runtime -----------------------------------------------------------------
NODE_ENV=development
TRACHEX_HOME=.trachex

# ---- LLM provider (BYOK) -----------------------------------------------------
# Provider: anthropic | openai | gemini | ollama
TRACHEX_PROVIDER=openai
TRACHEX_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ---- Dashboard / local API ---------------------------------------------------
TRACHEX_DASHBOARD_HOST=127.0.0.1
TRACHEX_DASHBOARD_PORT=8000

# ---- Local vector retrieval --------------------------------------------------
# Set COMPOSE_PROFILES=local to run Redis, the BullMQ worker, and Qdrant.
# Host pnpm dev uses localhost:6333; containers use qdrant:6333.
COMPOSE_PROFILES=local
TRACHEX_VECTOR_BACKEND=sqlite
QDRANT_URL=http://localhost:6333
QDRANT_COMPOSE_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=trachex

# ---- Async adjustment reconciliation ----------------------------------------
# Host pnpm dev uses localhost. Compose overrides this with redis://redis:6379.
TRACHEX_REDIS_URL=redis://localhost:6379

# ---- Optional PostgreSQL storage ---------------------------------------------
# SQLite remains the current canonical store. Reserved for the future adapter.
DATABASE_URL=postgresql://trachex:trachex@postgres:5432/trachex
POSTGRES_DB=trachex
POSTGRES_USER=trachex
POSTGRES_PASSWORD=change-me

# ---- Observability (optional) ------------------------------------------------
ANVIA_LENS_ENABLED=false
ANVIA_LENS_SERVICE_NAME=trachex
ANVIA_LENS_PUBLIC_KEY=
ANVIA_LENS_SECRET_KEY=
ANVIA_LENS_API_URL=

# ---- Anvia Studio (optional) -------------------------------------------------
ANVIA_STUDIO_PORT=4021
