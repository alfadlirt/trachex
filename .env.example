# Trachex environment configuration
# Copy to .env and fill in values. Never commit real secrets.

# ---- LLM provider (BYOK) ----------------------------------------------------
# Provider-agnostic OpenAI-compatible endpoint + key. Overrides provider profiles.
# Provider profile: anthropic | openai | gemini | ollama
TRACHEX_PROVIDER=openai
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# ---- Dashboard / local API --------------------------------------------------
# Hono API + bundled dashboard production settings
TRACHEX_HOME=/data/trachex
TRACHEX_DASHBOARD_HOST=0.0.0.0
TRACHEX_DASHBOARD_PORT=8000
TRACHEX_MODEL=gpt-4o-mini

# ---- Optional PostgreSQL storage ---------------------------------------------
# SQLite remains the current canonical store. Reserved for the future adapter.
DATABASE_URL=postgresql://trachex:trachex@postgres:5432/trachex
POSTGRES_DB=trachex
POSTGRES_USER=trachex
POSTGRES_PASSWORD=change-me

# ---- Observability (optional) ----------------------------------------------
# Anvia Lens reporting; enable only when configured.
ANVIA_LENS_ENABLED=false
ANVIA_LENS_PUBLIC_KEY=
ANVIA_LENS_SECRET_KEY=
ANVIA_LENS_API_URL=

# ---- Optional vector retrieval (Qdrant via Docker) --------------------------
# Local mode uses SQLite FTS5 and needs none of these.
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=trachex

# ---- Anvia Studio (optional dev tool) ---------------------------------------
ANVIA_STUDIO_PORT=4021
