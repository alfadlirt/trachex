{
  "name": "trachex",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first development traceability layer: requirements, changes, and development context synchronized for developers and AI coding agents.",
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=11"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.8.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "turbo run test",
    "dev": "turbo run dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.0",
    "turbo": "^2.10.5",
    "typescript": "^7.0.2"
  }
}
